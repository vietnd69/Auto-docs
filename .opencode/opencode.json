{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "model": "deepseek/deepseek-flash",
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    },
    "deepseek": {
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "tool_call": true
        }
      }
    },
    "dst-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:4141/v1",
        "headers": {
          "X-Harness-Job": "{env:HARNESS_JOB}"
        }
      },
      "models": {
        "planner": {
          "name": "gpt-oss:120b",
          "tool_call": true
        },
        "reflector": {
          "name": "gemma4:31b",
          "tool_call": true
        },
        "writer-experimental": {
          "name": "beam",
          "tool_call": true
        },
        "reviewer": {
          "name": "gpt-oss:120b",
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "dst-tools": {
      "type": "local",
      "command": [
        "{env:HARNESS_MCP_BIN}"
      ],
      "enabled": true
    }
  },
  "tools": {
    "bash": false,
    "write": false,
    "edit": false,
    "patch": false,
    "webfetch": false,
    "websearch": false,
    "todowrite": true,
    "task": true,
    "skill": true
  },
  "permission": {
    "edit": "deny",
    "bash": "deny",
    "webfetch": "deny"
  },
  "instructions": [
    ".opencode/harness/systemprompt.md",
    ".opencode/harness/guardrails.md",
    ".opencode/harness/LongTermMEMORY.md",
    ".opencode/harness/tool_descriptions/tool_guidance.md"
  ],
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "small_model": "deepseek/deepseek-flash",
  "agent": {
    "orchestrator": {
      "model": "deepseek/deepseek-flash"
    },
    "reviewer": {
      "model": "dst-proxy/reviewer"
    },
    "writer": {
      "model": "deepseek/deepseek-flash"
    },
    "planner": {
      "model": "dst-proxy/planner"
    },
    "reflector": {
      "model": "dst-proxy/reflector"
    },
    "writer-escalation": {
      "model": "anthropic/claude-sonnet-5-5"
    },
    "writer-experimental": {
      "model": "dst-proxy/writer-experimental"
    }
  }
}
